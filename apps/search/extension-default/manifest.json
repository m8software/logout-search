{
  "manifest_version": 3,
  "name": "logout search",
  "version": "1.0.0",
  "description": "Adds search.logout.cloud to your browser's search engines and offers to make it the default. It does nothing else.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_settings_overrides": {
    "search_provider": {
      "name": "logout",
      "keyword": "logout",
      "search_url": "https://search.logout.cloud/#q={searchTerms}",
      "suggest_url": "https://search.logout.cloud/api/suggest?q={searchTerms}",
      "favicon_url": "https://search.logout.cloud/favicon.png",
      "encoding": "UTF-8",
      "is_default": true
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "default-search@logout.cloud",
      "strict_min_version": "121.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
