{
  "manifest_version": 3,
  "name": "logout search — local",
  "version": "0.1.0",
  "description": "Answers searches on search.logout.cloud from the search engine on this computer. Nothing is sent to the site.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://search.logout.cloud/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "search@logout.cloud", "strict_min_version": "121.0" }
  }
}
